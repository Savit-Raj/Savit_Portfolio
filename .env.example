# Contact form delivery — both optional. With neither set, the form uses FormSubmit (no key needed).
# The very first submission emails you an "Activate Form" link; click it once and you're live.

# Optional: FormSubmit's random-string alias for your address (it's in the activation email).
# Set it to keep your email address out of the page's network requests.
VITE_FORMSUBMIT_ID=

# Optional: use Web3Forms instead (free key from https://web3forms.com — designed to be public).
VITE_WEB3FORMS_ACCESS_KEY=
